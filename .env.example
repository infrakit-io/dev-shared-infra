# No environment variables required by default.
#
# CF_TUNNEL_TOKEN is fetched at runtime from SOPS via the extract script.
# Override defaults only if your setup differs:
#
#   TUNNEL_NAME=dev-macbook   # tunnel name in cloudflare-zero-trust.sops.yaml
#   INFRA_CONFIG_PATH=$HOME/work/Bibi40k-GIT/infrakit-io/i.cadolino-infra-config
#
# Pass as env or as task vars:
#   task up TUNNEL_NAME=your-tunnel INFRA_CONFIG_PATH=/your/path
