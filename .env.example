# dev-shared-infra environment
# Copy to .env and fill in.

# Cloudflare Tunnel token (create in Cloudflare Zero Trust Dashboard, store securely).
# Tunnel should have ingress rule: *.dev.<your-domain> -> http://traefik:80
# Get from: https://one.dash.cloudflare.com/ -> Zero Trust -> Networks -> Tunnels
# -> <your-tunnel> -> Connector token.
CF_TUNNEL_TOKEN=
